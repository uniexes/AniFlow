{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aniflow",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}